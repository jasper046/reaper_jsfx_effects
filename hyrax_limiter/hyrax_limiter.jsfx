desc:Hyrax Limiter
//tags: dynamics limiter mastering
//author: port of Matchering "Hyrax" limiter

// Real-time causal approximation of the Matchering (Sergree) "Hyrax"
// mastering limiter: sliding-window peak detection feeding a look-ahead
// attack stage and a multi-stage (hold + two cascaded one-pole low-pass)
// release envelope. The look-ahead delay is reported to the host for
// latency compensation. Peak detection can optionally run 4x oversampled
// to catch inter-sample (true-peak) overshoots; the audio path itself is
// never oversampled, matching Matchering's clean sample-domain gain stage.

slider1:0<-30,0,0.1>Threshold (dB)
slider2:-0.1<-6,0,0.1>Ceiling (dB)
slider3:1<0,20,0.1>Look Ahead (ms)
slider4:3000<50,6000,10>Release (ms)
slider5:100<0,100,1>Stereo Link (%)
slider6:1<0,1,1{Off,On}>True Peak Detection
slider7:-14<-30,-5,0.1>Target LUFS (short-term)
slider8:0<0,1,1{Off,On}>SENSE (auto threshold)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init

ext_tail_size = -1;
ext_gr_meter = 0;

// Matchering baked-in constants
HOLD_MS = 1;               // limiter.hold
HOLD_LP_HZ = 7;            // 1st-order Butterworth hold cutoff
RELEASE_LP_NUM = 800;      // release cutoff = RELEASE_LP_NUM / release_ms
ATTACK_SMOOTH = 2;         // attack filter smoothing (matchering attack_filter_coefficient magnitude)

// Ring buffer for look-ahead audio (stereo interleaved). Sized for the
// max look-ahead (20 ms) at any sample rate, rounded up generously.
LA_MAX = ceil(0.025 * srate) + 4;
buf0 = 0;                  // left channel ring buffer base
buf1 = buf0 + LA_MAX;      // right channel ring buffer base
// Peak-detection ring buffer holds per-sample detection peaks so we can
// run a true sliding maximum over the look-ahead window.
pkbuf = buf1 + LA_MAX;
freemem = pkbuf + LA_MAX;

wpos = 0;

// 4x oversampling polyphase state for the detection sidechain: a simple
// 4-tap windowed-sinc upsampler per channel is overkill here; instead we
// estimate inter-sample peaks with a short Lagrange/linear-max between
// consecutive samples, which is cheap and catches the dominant overshoot.
os_l1 = os_l0 = 0;
os_r1 = os_r0 = 0;

// Reduction-domain envelope state (0 = no reduction).
d_atk = 0;
d_hold = 0;
rel_lp1 = 0;
rel_lp2 = 0;
hold_ctr = 0;

gr_meter = 1;
gr_meter_decay = exp(1/(1*srate));

// --- ITU-R BS.1770 K-weighting filter (two biquads, run on mono output sum) ---
// Stage 1: high-shelf (+4 dB boost above ~1681 Hz). Stage 2: high-pass (~38 Hz).
// Coefficients are the standard 48 kHz reference values, re-derived here for the
// actual sample rate so the meter is correct at any rate.
function kweight_coeffs() local(
  db_boost, fc_shelf, Q_shelf, K, Vh, Vb, a0s,
  fc_hp, Q_hp, w0, alpha, cw, a0h) (
  // --- high-shelf (pre-filter, "stage 1") ---
  db_boost = 3.999843853973347;
  fc_shelf = 1681.974450955533;
  Q_shelf  = 0.7071752369554196;
  K  = tan($pi * fc_shelf / srate);
  Vh = 10^(db_boost/20);
  Vb = Vh^0.4996667741545416;
  a0s = 1 + K/Q_shelf + K*K;
  sh_b0 = (Vh + Vb*K/Q_shelf + K*K) / a0s;
  sh_b1 = 2*(K*K - Vh) / a0s;
  sh_b2 = (Vh - Vb*K/Q_shelf + K*K) / a0s;
  sh_a1 = 2*(K*K - 1) / a0s;
  sh_a2 = (1 - K/Q_shelf + K*K) / a0s;
  // --- high-pass ("stage 2") ---
  fc_hp = 38.13547087602444;
  Q_hp  = 0.5003270373238773;
  w0 = 2*$pi*fc_hp/srate;
  cw = cos(w0);
  alpha = sin(w0)/(2*Q_hp);
  a0h = 1 + alpha;
  hp_b0 = (1 + cw)/2 / a0h;
  hp_b1 = -(1 + cw) / a0h;
  hp_b2 = (1 + cw)/2 / a0h;
  hp_a1 = -2*cw / a0h;
  hp_a2 = (1 - alpha) / a0h;
);
kweight_coeffs();

// biquad state for the two K-weighting stages, per channel (L and R measured
// independently, then their mean-squares summed per BS.1770).
shl_z1 = shl_z2 = hpl_z1 = hpl_z2 = 0;
shr_z1 = shr_z2 = hpr_z1 = hpr_z2 = 0;

// 3-second short-term LUFS: running sum of K-weighted mean square over a
// circular buffer holding one sample of squared value per slot.
ST_LEN   = ceil(3 * srate);
msbuf    = freemem;
freemem += ST_LEN;
memset(msbuf, 0, ST_LEN);
mspos    = 0;
ms_sum   = 0;
lufs_st  = -144;           // current short-term LUFS reading

// SENSE loop state: slow, damped adjustment of the threshold slider.
// Gain and rate are tuned for stability against the 3 s measurement lag: a
// faster loop oscillates because it reacts to stale short-term readings.
sense_gain = 0.05;         // proportional step fraction of the LUFS error, tuned below
sense_rate_db = 0.5;       // max threshold movement in dB per second
sense_update_ctr = 0;
sense_update_every = floor(srate / 20);  // recompute the loop 20x/sec

@slider

thresh = 10^(slider1/20);
ceiling = 10^(slider2/20);
makeup = ceiling / thresh;             // matchering normalizes to threshold, then to ceiling

look_samples = max(1, floor(slider3 * 0.001 * srate));
look_samples = min(look_samples, LA_MAX - 1);

release_ms = max(slider4, 1);
link = slider5 * 0.01;
truepeak = slider6;
target_lufs = slider7;
sense_on = slider8;

// Sliding-max hold window length (samples)
hold_samples = max(1, floor(HOLD_MS * 0.001 * srate));

// One-pole low-pass coefficients from Butterworth cutoffs.
// 1st-order Butterworth == one-pole: a = exp(-2*pi*fc/fs)
hold_a = exp(-2*$pi*HOLD_LP_HZ/srate);
rel_fc = RELEASE_LP_NUM / release_ms;   // matchering: release_filter_coefficient / release
rel_a = exp(-2*$pi*rel_fc/srate);

// Attack smoothing one-pole (approximates matchering's zero-phase filtfilt
// over the attack window; look-ahead delay supplies the "future" it needs).
atk_a = exp(-ATTACK_SMOOTH / max(look_samples,1));

// Report look-ahead latency so the host time-aligns our output.
pdc_delay = look_samples;
pdc_bot_ch = 0;
pdc_top_ch = 2;

@sample

// --- detection: per-sample peak, optionally true-peak (inter-sample) ---
absl = abs(spl0);
absr = abs(spl1);
detect = max(absl, absr);

truepeak ? (
  // Estimate inter-sample peaks via 4x linear interpolation between the
  // previous and current sample on each channel and take the max.
  ip = 0.25;
  loop(3,
    il = os_l1 + (spl0 - os_l1) * ip;
    ir = os_r1 + (spl1 - os_r1) * ip;
    detect = max(detect, max(abs(il), abs(ir)));
    ip += 0.25;
  );
  os_l1 = spl0;
  os_r1 = spl1;
);

// --- write current sample into look-ahead ring buffers ---
buf0[wpos] = spl0;
buf1[wpos] = spl1;
pkbuf[wpos] = detect;

// --- sliding maximum over the look-ahead window (attack stage input) ---
// Scan the window for the max detection peak. Window is short (<=~1ms
// typical), so a direct scan is acceptable and matches matchering's
// maximum_filter1d semantics exactly.
win_max = 0;
i = 0;
loop(look_samples + 1,
  ri = wpos - i;
  ri < 0 ? ri += LA_MAX;
  win_max = max(win_max, pkbuf[ri]);
  i += 1;
);

// Everything below works in Matchering's "flipped" reduction domain:
//   d = 1 - gain,  where 0 = no reduction and larger = more reduction.
// The three stages (hard-clip, attack, release) each produce a reduction
// amount; Matchering combines them with max_mix (take the MOST reduction)
// and flips back to a gain. We mirror that exactly.

// --- hard-clip reduction for this windowed peak ---
// rectify: floor at threshold, normalize. gain = thresh/peak (<=1).
win_max <= thresh ? hc_gain = 1 : hc_gain = thresh / win_max;
d_hard = 1 - hc_gain;                  // flipped hard-clip reduction

// --- attack stage: one-pole smoothing of the hard-clip reduction ---
// Reduction rises instantly (attack) and decays via the smoothing pole.
// The look-ahead delay on the audio path means this ramp lands slightly
// before the transient reaches the output tap (approximating filtfilt).
d_hard > d_atk ? d_atk = d_hard : d_atk = d_hard + atk_a * (d_atk - d_hard);

// --- hold + release stage on the reduction envelope ---
// Hold: keep the peak reduction for hold_samples, then let it fall.
d_hard >= d_hold ? (
  d_hold = d_hard;
  hold_ctr = 0;
) : (
  (hold_ctr += 1) > hold_samples ? (
    d_hold = d_hard + hold_a * (d_hold - d_hard);
  );
);

// Two cascaded one-pole low-passes shape the release, fed by the greater
// of the raw and held reduction (matchering: max(slided, hold_output)).
rel_in = max(d_hard, d_hold);
rel_lp1 = rel_in + rel_a * (rel_lp1 - rel_in);
rel_lp2 = rel_lp1 + rel_a * (rel_lp2 - rel_lp1);
d_rel = max(d_hold, rel_lp2);          // matchering: max(hold_output, release_output)

// --- combine stages: most reduction wins (max_mix), then flip to gain ---
d_final = max(d_hard, max(d_atk, d_rel));
gain = 1 - d_final;

// --- stereo link ---
// Detection is fully linked at link=100% (shared win_max drives one gain).
// Below 100%, blend the shared reduction with each channel's own reduction
// so the louder channel keeps the shared value and the quieter one is let
// off proportionally. At link=0 each channel limits to its own peak.
dl_own = absl <= thresh ? 0 : 1 - thresh/absl;
dr_own = absr <= thresh ? 0 : 1 - thresh/absr;
gl = 1 - (link * d_final + (1-link) * dl_own);
gr = 1 - (link * d_final + (1-link) * dr_own);

// --- read delayed audio from ring buffer and apply gain + makeup ---
rpos = wpos - look_samples;
rpos < 0 ? rpos += LA_MAX;
spl0 = buf0[rpos] * gl * makeup;
spl1 = buf1[rpos] * gr * makeup;

(wpos += 1) >= LA_MAX ? wpos = 0;

// --- short-term LUFS measurement on the output (BS.1770 K-weighting) ---
// Each channel through its own K-weighting biquad pair; sum the per-channel
// mean-squares (channel weight 1.0 for L/R) as the standard specifies.
shl = sh_b0*spl0 + shl_z1;
shl_z1 = sh_b1*spl0 - sh_a1*shl + shl_z2;
shl_z2 = sh_b2*spl0 - sh_a2*shl;
kl = hp_b0*shl + hpl_z1;
hpl_z1 = hp_b1*shl - hp_a1*kl + hpl_z2;
hpl_z2 = hp_b2*shl - hp_a2*kl;

shr = sh_b0*spl1 + shr_z1;
shr_z1 = sh_b1*spl1 - sh_a1*shr + shr_z2;
shr_z2 = sh_b2*spl1 - sh_a2*shr;
kr = hp_b0*shr + hpr_z1;
hpr_z1 = hp_b1*shr - hp_a1*kr + hpr_z2;
hpr_z2 = hp_b2*shr - hp_a2*kr;

// slide the 3-second mean-square window (summed L^2 + R^2)
ksq = kl*kl + kr*kr;
ms_sum += ksq - msbuf[mspos];
msbuf[mspos] = ksq;
(mspos += 1) >= ST_LEN ? mspos = 0;

// --- SENSE closed loop: ride the threshold slider toward the target LUFS ---
(sense_update_ctr += 1) >= sense_update_every ? (
  sense_update_ctr = 0;
  mean_ms = ms_sum / ST_LEN;
  lufs_st = mean_ms > 0 ? -0.691 + 10*log10(mean_ms) : -144;

  sense_on && lufs_st > -70 ? (
    // error > 0 means we're too quiet -> lower threshold (more limiting/makeup)
    err = target_lufs - lufs_st;
    // max threshold move per update, rate-limited to sense_rate_db per second
    max_step = sense_rate_db * sense_update_every / srate;
    // proportional step toward target, clamped to the rate limit
    step = err * sense_gain;
    step > max_step ? step = max_step : step < -max_step ? step = -max_step;
    // louder (err>0) needs LOWER threshold, so subtract the (positive) error step
    new_thresh_db = slider1 - step;
    new_thresh_db < -30 ? new_thresh_db = -30 : new_thresh_db > 0 ? new_thresh_db = 0;
    new_thresh_db != slider1 ? (
      slider1 = new_thresh_db;
      thresh = 10^(slider1/20);
      makeup = ceiling / thresh;
      slider_automate(slider1);
    );
  );
);

// --- gain reduction meter ---
gain < gr_meter ? gr_meter = gain : ( gr_meter *= gr_meter_decay; gr_meter > 1 ? gr_meter = 1; );

@block
ext_gr_meter = gr_meter > 0 ? log(gr_meter) * (20/log(10)) : -150;

@gfx 0 64

  gr_meter *= exp(1/30); gr_meter>1?gr_meter=1;
  gfx_r=1; gfx_g=gfx_b=0; gfx_a=0.8;

  meter_bot=20;
  meter_h=min(gfx_h,32);
  xscale=gfx_w*20/meter_bot;

  gfx_y=0;
  gfx_x=gfx_w + log10(gr_meter)*xscale;
  gfx_rectto(gfx_w,meter_h);

  gfx_r=gfx_g=gfx_b=1.0; gfx_a=0.6;

  s2=sqrt(2)/2;
  g = s2;
  while(
    gfx_x=gfx_w + log10(g)*xscale;
    gfx_x >= 0 ?
    (
      gfx_y=0;
      gfx_lineto(gfx_x,meter_h,0);
      gfx_y=meter_h-gfx_texth;
      gfx_x+=2;
      gfx_drawnumber(log10(g)*20,0);
      gfx_drawchar($'d');
      gfx_drawchar($'B');
    );
    g*=s2;
    gfx_x >=0;
  );
  gfx_a=1;

  gfx_x=0; gfx_y=meter_h/2 - gfx_texth/2;
  gfx_drawnumber(log10(gr_meter)*20,1);
  gfx_drawchar($'d');
  gfx_drawchar($'B');

  // --- short-term LUFS readout row (below the GR meter) ---
  lrow_y = meter_h + 4;
  gfx_a = 1;
  // short-term LUFS value
  gfx_x = 4; gfx_y = lrow_y;
  gfx_r = gfx_g = gfx_b = 1.0;
  lufs_st > -70 ? gfx_drawnumber(lufs_st, 1) : gfx_drawstr("-inf");
  gfx_drawstr(" LUFS-S");
  // target + SENSE status
  gfx_x = 4; gfx_y = lrow_y + gfx_texth + 2;
  sense_on ? ( gfx_r = 0.4; gfx_g = 1.0; gfx_b = 0.4; ) : ( gfx_r = gfx_g = gfx_b = 0.6; );
  gfx_drawstr(sense_on ? "SENSE > " : "target ");
  gfx_drawnumber(target_lufs, 1);
  gfx_drawstr(" LUFS");
